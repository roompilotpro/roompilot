# Database Configuration
# Copy this file to .env.local and uncomment the database you want to use

# Option 1: Neon Cloud Database (example - set your own values)
DATABASE_URL=jdbc:postgresql://<host>/<db_name>?user=<user>&password=<password>&sslmode=require&channel_binding=require

# Option 2: Local PostgreSQL via Docker
# DATABASE_URL=jdbc:postgresql://localhost:5432/roompilot?user=roompilot&password=roompilot123
